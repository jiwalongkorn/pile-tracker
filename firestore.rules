rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Project data: public read, authenticated write
    match /projects/{projectId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Settings: public read (needed to load gemini key & drive URL), authenticated write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
